{
  "name": "rme-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:features": "node scripts/check-feature-docs.mjs",
    "check:docs": "npm run check:features && node scripts/check-doc-links.mjs",
    "migrate": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate.mjs down",
    "migrate:status": "node scripts/migrate.mjs status",
    "db:seed": "node scripts/seed-platform-fixtures.mjs",
    "db:backup": "node scripts/backup-restore.mjs backup",
    "db:restore": "node scripts/backup-restore.mjs restore",
    "test": "node --test --test-concurrency=1 test/**/*.test.mjs"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
